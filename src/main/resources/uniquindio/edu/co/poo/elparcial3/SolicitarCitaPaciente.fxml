<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20" style="-fx-background-color: #ecf0f1; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.co.poo.elparcial3.ViewController.SolicitarCitaPacienteViewController">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label style="-fx-font-size: 32px;" text="➕" />
        <VBox>
            <Label text="Solicitar Nueva Cita" textFill="#2c3e50">
                <font><Font name="System Bold" size="26" /></font>
            </Label>
            <Label text="Completa el formulario para agendar tu consulta" textFill="#7f8c8d">
                <font><Font size="14" /></font>
            </Label>
        </VBox>
    </HBox>

    <!-- Scroll principal -->
    <ScrollPane fitToWidth="true" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">

        <!-- Contenedor principal (dos columnas) -->
        <HBox alignment="TOP_CENTER" spacing="30" style="-fx-padding: 10;">

            <!-- Columna izquierda (Formulario) -->
            <VBox spacing="20" style="-fx-background-color: white;                          -fx-background-radius: 12;                          -fx-padding: 30;                          -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);                          -fx-pref-width: 650;">

                <!-- Paso 1 -->
                <VBox spacing="15">
                    <Label text="1. Selecciona un Médico" textFill="#2c3e50">
                        <font><Font name="System Bold" size="18" /></font>
                    </Label>

                    <VBox spacing="8">
                        <Label text="Médico *" textFill="#2c3e50">
                            <font><Font name="System Bold" size="13" /></font>
                        </Label>
                        <ComboBox fx:id="cmbMedico" maxWidth="Infinity" promptText="Primero selecciona un medico" style="-fx-background-color: #ecf0f1; -fx-background-radius: 6;" />
                        <Label fx:id="lblInfoMedico" text="ℹ️ Selecciona un médico para ver su disponibilidad" textFill="#7f8c8d" wrapText="true">
                            <font><Font size="11" /></font>
                        </Label>
                    </VBox>
                </VBox>

                <Separator />

                <!-- Paso 2: Fecha y Hora -->
                <VBox spacing="15">
                    <Label text="2. Elige Fecha y Hora" textFill="#2c3e50">
                        <font><Font name="System Bold" size="18" /></font>
                    </Label>

                    <HBox spacing="15">
                        <VBox spacing="8" HBox.hgrow="ALWAYS">
                            <Label text="Fecha *" textFill="#2c3e50">
                                <font><Font name="System Bold" size="13" /></font>
                            </Label>
                            <DatePicker fx:id="dpFecha" maxWidth="Infinity" promptText="dd/mm/yyyy" style="-fx-background-color: #ecf0f1; -fx-background-radius: 6;" />
                        </VBox>

                        <VBox prefHeight="54.0" prefWidth="313.0" spacing="8" HBox.hgrow="ALWAYS">
                            <Label textFill="#2c3e50">
                                <font><Font name="System Bold" size="13" /></font>
                            </Label>
                        </VBox>
                    </HBox>

                    <!-- Horarios disponibles -->
                    <VBox spacing="8">
                        <Label text="Selecciona Una Hora * :">
                            <font><Font name="System Bold" size="12" /></font>
                        </Label>

                        <FlowPane fx:id="flowHorarios" hgap="10" prefWrapLength="350" vgap="10">
                        </FlowPane>
                    </VBox>
                </VBox>

                <Separator />

                <!-- Paso 3 -->
                <VBox spacing="15">
                    <Label text="3. Información de la Consulta" textFill="#2c3e50">
                        <font><Font name="System Bold" size="18" /></font>
                    </Label>

                    <VBox spacing="8">
                        <Label text="Motivo de la Consulta *" textFill="#2c3e50">
                            <font><Font name="System Bold" size="13" /></font>
                        </Label>
                        <TextArea fx:id="txtMotivo" prefRowCount="4" promptText="Describe brevemente el motivo..." style="-fx-background-color: #ecf0f1; -fx-background-radius: 6; -fx-padding: 10;" wrapText="true" />
                        <Label text="Máximo 500 caracteres" textFill="#95a5a6">
                            <font><Font size="11" /></font>
                        </Label>
                    </VBox>
                </VBox>

                <Separator />

                <!-- Botones -->
                <HBox alignment="CENTER" spacing="15">
                    <Button fx:id="btnCancelar" onAction="#cancelar" style="-fx-background-color: #95a5a6; -fx-text-fill: white;                                    -fx-background-radius: 8; -fx-padding: 12 40;" text="Cancelar" />

                    <Button fx:id="btnConfirmar" onAction="#confirmarCita" style="-fx-background-color: #27ae60; -fx-text-fill: white;                                    -fx-background-radius: 8; -fx-font-weight: bold;                                    -fx-padding: 12 40;" text="✓ Confirmar Cita" />
                </HBox>

                <Label text="* Campos obligatorios" textFill="#e74c3c">
                    <font><Font size="11" /></font>
                </Label>
            </VBox>

            <!-- Columna derecha (Resumen) -->
            <VBox spacing="20" style="-fx-pref-width: 320;">

                <!-- Resumen -->
                <VBox spacing="15" style="-fx-background-color: white;                              -fx-background-radius: 12;                              -fx-padding: 25;                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                    <Label text="📋 Resumen de tu Cita" textFill="#2c3e50">
                        <font><Font name="System Bold" size="16" /></font>
                    </Label>

                    <Separator />

                    <VBox spacing="10">
                        <HBox spacing="8">
                            <Label style="-fx-font-size: 16;" text="👨‍⚕️" />
                            <VBox spacing="3">
                                <Label text="Médico" textFill="#7f8c8d">
                                    <font><Font size="11" /></font>
                                </Label>
                                <Label fx:id="lblResumenMedico" text="No seleccionado" textFill="#2c3e50">
                                    <font><Font name="System Bold" size="13" /></font>
                                </Label>
                            </VBox>
                        </HBox>

                        <HBox spacing="8">
                            <Label style="-fx-font-size: 16;" text="📅" />
                            <VBox spacing="3">
                                <Label text="Fecha y Hora" textFill="#7f8c8d">
                                    <font><Font size="11" /></font>
                                </Label>
                                <Label fx:id="lblResumenFecha" text="No seleccionada" textFill="#2c3e50">
                                    <font><Font name="System Bold" size="13" /></font>
                                </Label>
                            </VBox>
                        </HBox>


                        <HBox spacing="8">
                            <Label style="-fx-font-size: 16;" text="⏱️" />
                            <VBox spacing="3">
                                <Label text="Duración" textFill="#7f8c8d">
                                    <font><Font size="11" /></font>
                                </Label>
                                <Label fx:id="lblResumenDuracion" text="30 minutos" textFill="#2c3e50">
                                    <font><Font name="System Bold" size="13" /></font>
                                </Label>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Consejos -->
                <VBox spacing="12" style="-fx-background-color: #e8f5e9;                              -fx-border-color: #27ae60;                              -fx-border-width: 1;                              -fx-border-radius: 10;                              -fx-background-radius: 10;                              -fx-padding: 20;">

                    <Label text="💡 Consejos Útiles" textFill="#27ae60">
                        <font><Font name="System Bold" size="14" /></font>
                    </Label>

                    <VBox spacing="8">
                        <Label text="• Llega 10 minutos antes" textFill="#2c3e50" wrapText="true" />
                        <Label text="• Trae tu documento de identidad" textFill="#2c3e50" wrapText="true" />
                        <Label text="• Si tienes exámenes previos, tráelos" textFill="#2c3e50" wrapText="true" />
                        <Label text="• Puedes cancelar tu cita cuando quieras" textFill="#2c3e50" wrapText="true" />
                    </VBox>
                </VBox>
                <!-- Contacto -->
                <VBox spacing="10" style="-fx-background-color: white;                              -fx-background-radius: 12;                              -fx-padding: 20;                              -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <Label text="📞 ¿Necesitas ayuda?" textFill="#2c3e50">
                        <font><Font name="System Bold" size="14" /></font>
                    </Label>
                    <Label text="Llámanos: (123) 456-7890" textFill="#7f8c8d" wrapText="true" />
                    <Label text="Email: citas@clinica.com" textFill="#7f8c8d" wrapText="true" />
                </VBox>

            </VBox>

        </HBox>

    </ScrollPane>

</VBox>

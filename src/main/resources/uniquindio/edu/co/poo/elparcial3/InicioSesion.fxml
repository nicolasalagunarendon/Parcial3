<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane style="-fx-background-color: linear-gradient(to bottom right, #2c3e50, #34495e, #3498db);" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.co.poo.elparcial3.ViewController.InicioSesionViewController">

    <!-- Contenedor Principal con efecto de tarjeta -->
    <VBox alignment="CENTER" maxHeight="600" maxWidth="450" style="-fx-background-color: white; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 30, 0, 0, 10);">

        <padding>
            <Insets bottom="50" left="50" right="50" top="50" />
        </padding>

        <!-- Header con Logo y Título -->
        <VBox alignment="CENTER" spacing="10">
            <!-- Ícono de clínica (puedes reemplazar con tu logo) -->
            <Label style="-fx-font-size: 60px;" text="🏥" />

            <Label text="Clínica Integral" textFill="#2c3e50">
                <font>
                    <Font name="System Bold" size="32.0" />
                </font>
            </Label>

            <Label text="Sistema de Gestión Médica" textFill="#7f8c8d">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
        </VBox>

        <!-- Espaciador -->
        <Region prefHeight="30" />

        <!-- Formulario de Login -->
        <VBox alignment="CENTER" spacing="20">

            <!-- Campo de Usuario/Email -->
            <VBox spacing="8">
                <Label prefHeight="19.0" prefWidth="24.0" text="ID" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>

                <HBox fx:id="usernameBox" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #ecf0f1; -fx-background-radius: 10; -fx-padding: 12 15;">
                    <Label style="-fx-font-size: 18px;" text="👤" />
                    <TextField fx:id="usernameField" promptText="Ingrese su ID" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS">
                    </TextField>
                </HBox>
            </VBox>

            <!-- Campo de Contraseña -->
            <VBox spacing="8">
                <Label text="Contraseña" textFill="#2c3e50">
                    <font>
                        <Font name="System Bold" size="13.0" />
                    </font>
                </Label>

                <HBox fx:id="passwordBox" alignment="CENTER_LEFT" spacing="10" style="-fx-background-color: #ecf0f1; -fx-background-radius: 10; -fx-padding: 12 15;">
                    <Label style="-fx-font-size: 18px;" text="🔒" />

                    <PasswordField fx:id="passwordField" promptText="Ingrese su contraseña" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px;" HBox.hgrow="ALWAYS">
                    </PasswordField>

                    <TextField fx:id="passwordTextField" managed="false" promptText="Ingrese su contraseña" style="-fx-background-color: transparent; -fx-border-color: transparent; -fx-font-size: 14px;" visible="false" HBox.hgrow="ALWAYS">
                    </TextField>

                    <Button fx:id="togglePasswordButton" onAction="#togglePasswordVisibility" style="-fx-background-color: transparent; -fx-cursor: hand; -fx-font-size: 16px; -fx-border-color: transparent;" text="👁">
                    </Button>
                </HBox>
            </VBox>

            <!-- Botón de Iniciar Sesión -->
            <Button fx:id="loginButton" maxWidth="Infinity" onAction="#handleLogin" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 15; -fx-cursor: hand;" text="Iniciar Sesión">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Button>

            <!-- Mensaje de error (oculto por defecto) -->
            <Label fx:id="errorLabel" managed="false" style="-fx-background-color: rgba(231, 76, 60, 0.1); -fx-background-radius: 5; -fx-padding: 10;" textAlignment="CENTER" textFill="#e74c3c" visible="false" wrapText="true">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>

        </VBox>

        <!-- Espaciador -->
        <Region prefHeight="20" VBox.vgrow="ALWAYS" />

        <!-- Footer -->
        <VBox alignment="CENTER" spacing="10">
            <Separator prefWidth="300" style="-fx-background-color: #bdc3c7;" />

            <Label text="v1.0.0 © 2025 Clínica Integral" textFill="#95a5a6">
                <font>
                    <Font size="10.0" />
                </font>
            </Label>
        </VBox>

    </VBox>

</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="20" style="-fx-background-color: #ecf0f1; -fx-padding: 30;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="uniquindio.edu.co.poo.elparcial3.ViewController.CitasProgramadasPacienteViewController">

    <!-- Header de la sección -->
    <HBox alignment="CENTER_LEFT" spacing="15">
        <Label style="-fx-font-size: 32px;" text="📅" />
        <VBox>
            <Label text="Mis Citas Programadas" textFill="#2c3e50">
                <font>
                    <Font name="System Bold" size="26.0" />
                </font>
            </Label>
            <Label text="Consulta tus próximas citas médicas" textFill="#7f8c8d">
                <font>
                    <Font size="14.0" />
                </font>
            </Label>
        </VBox>
        <Region HBox.hgrow="ALWAYS" />
    </HBox>

    <!-- Tarjetas de estadísticas -->
    <HBox spacing="15">
        <!-- Próxima cita -->
        <VBox spacing="8" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <Label text="Próxima Cita" textFill="#7f8c8d">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
            <Label fx:id="lblProximaCita" text="22 Nov - 10:30 AM" textFill="#e74c3c">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
            <Label fx:id="lblProximoDoctor" text="Dr. Juan Pérez" textFill="#7f8c8d">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
        </VBox>

        <!-- Pendientes -->
        <VBox spacing="5" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <Label text="Citas Pendientes" textFill="#7f8c8d">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblCitasPendientes" text="3" textFill="#e67e22">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Label style="-fx-font-size: 24px;" text="⏰" />
            </HBox>
        </VBox>

        <!-- Este mes -->
        <VBox spacing="5" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);" HBox.hgrow="ALWAYS">
            <Label text="Este Mes" textFill="#7f8c8d">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label fx:id="lblCitasMes" text="5" textFill="#3498db">
                    <font>
                        <Font name="System Bold" size="28.0" />
                    </font>
                </Label>
                <Label style="-fx-font-size: 24px;" text="📊" />
            </HBox>
        </VBox>
    </HBox>

    <!-- Mensaje de recordatorio -->
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: #fff3cd; -fx-border-color: #ffc107; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8; -fx-padding: 15;">
        <Label style="-fx-font-size: 24px;" text="💡" />
        <VBox spacing="3">
            <Label text="Recuerda llegar 10 minutos antes de tu cita" textFill="#856404">
                <font>
                    <Font name="System Bold" size="13.0" />
                </font>
            </Label>
            <Label text="Trae tu documento de identidad y exámenes previos si los tienes" textFill="#856404">
                <font>
                    <Font size="12.0" />
                </font>
            </Label>
        </VBox>
    </HBox>

    <!-- Filtros -->
    <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-background-color: white; -fx-background-radius: 10; -fx-padding: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Filtrar:" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
        </Label>
        <ComboBox fx:id="cmbFiltroEstado" prefWidth="140" promptText="Todas" style="-fx-background-color: #ecf0f1; -fx-background-radius: 5;">
        </ComboBox>
        <ComboBox fx:id="cmbFiltroMes" prefWidth="140" promptText="Este mes" style="-fx-background-color: #ecf0f1; -fx-background-radius: 5;">
        </ComboBox>
        <Region HBox.hgrow="ALWAYS" />
        <CheckBox fx:id="chkSoloProximas" text="Solo próximas" textFill="#2c3e50">
            <font>
                <Font size="13.0" />
            </font>
        </CheckBox>
    </HBox>

    <!-- Lista de citas (ScrollPane con tarjetas) -->
    <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox fx:id="vboxCitas" spacing="15" style="-fx-padding: 5;">

            <!-- Ejemplo de tarjeta de cita -->
            <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">

                <!-- Fecha destacada -->
                <VBox alignment="CENTER" spacing="5" style="-fx-background-color: #3498db; -fx-background-radius: 10; -fx-padding: 15; -fx-min-width: 90;">
                    <Label text="NOV" textFill="white">
                        <font>
                            <Font name="System Bold" size="14.0" />
                        </font>
                    </Label>
                    <Label text="22" textFill="white">
                        <font>
                            <Font name="System Bold" size="32.0" />
                        </font>
                    </Label>
                    <Label text="Viernes" textFill="#ecf0f1">
                        <font>
                            <Font size="11.0" />
                        </font>
                    </Label>
                </VBox>

                <!-- Información de la cita -->
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label style="-fx-font-size: 18px;" text="🩺" />
                        <Label text="Consulta General" textFill="#2c3e50">
                            <font>
                                <Font name="System Bold" size="16.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label style="-fx-background-color: #ecf0f1; -fx-background-radius: 5; -fx-padding: 5 10;" text="⏰ 10:30 AM" textFill="#7f8c8d">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                        </Label>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="👨‍⚕️" />
                        <Label text="Dr. Juan Pérez - Medicina General" textFill="#7f8c8d">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="📍" />
                        <Label text="Consultorio 203, Edificio Principal" textFill="#7f8c8d">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label text="📝" />
                        <Label text="Motivo: Control rutinario y revisión de exámenes" textFill="#7f8c8d">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>
                    </HBox>
                </VBox>

                <!-- Botones de acción -->
                <VBox alignment="CENTER" spacing="10">
                    <Button style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 20; -fx-cursor: hand; -fx-min-width: 130;" text="Ver Detalles">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Button>
                    <Button style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 6; -fx-padding: 8 20; -fx-cursor: hand; -fx-min-width: 130;" text="Cancelar">
                        <font>
                            <Font name="System Bold" size="12.0" />
                        </font>
                    </Button>
                </VBox>
            </HBox>

            <!-- Placeholder cuando no hay citas -->
            <!-- Este VBox se mostraría dinámicamente cuando vboxCitas esté vacío -->
            <!--
            <VBox alignment="CENTER" spacing="15" style="-fx-padding: 60; -fx-background-color: white; -fx-background-radius: 10;">
                <Label text="📅" style="-fx-font-size: 64px;" />
                <Label text="No tienes citas programadas" textFill="#7f8c8d">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Label text="Solicita una nueva cita para comenzar" textFill="#95a5a6">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Button text="➕ Solicitar Cita" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 8; -fx-padding: 12 30; -fx-cursor: hand; -fx-font-weight: bold;">
                </Button>
            </VBox>
            -->

        </VBox>
    </ScrollPane>

</VBox>
